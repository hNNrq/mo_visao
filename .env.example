# ==========================================================
# Mo Visão — variáveis de ambiente
# Copiar pra .env.local e preencher. O .env.local NÃO vai pro git.
# ==========================================================

# Supabase — painel do projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ Service role ignora todas as regras de segurança do banco.
# SÓ no servidor. Nunca prefixar com NEXT_PUBLIC_, nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — conta do DONO, nunca a da Norman.dgt
# Credenciais em: mercadopago.com.br/developers > Suas integrações
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Chave secreta do webhook (Webhooks > Configurar notificações)
MERCADOPAGO_WEBHOOK_SECRET=

# Email transacional (Resend)
RESEND_API_KEY=
EMAIL_REMETENTE=
EMAIL_DONO=

# Endereço público do site (sem barra no fim)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo do job de liberar reservas (Netlify scheduled function)
CRON_SECRET=
