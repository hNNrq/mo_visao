# ==========================================================
# Mo Visão — variáveis de ambiente
# Copiar pra .env.local e preencher. O .env.local NÃO vai pro git.
# ==========================================================

# Supabase — painel do projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ Service role ignora todas as regras de segurança do banco.
# SÓ no servidor. Nunca prefixar com NEXT_PUBLIC_, nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — conta do DONO, nunca a da Norman.dgt
# Credenciais em: mercadopago.com.br/developers > Suas integrações
# Sem o token, o site sobe e o botão de pagar fica desligado.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (Webhooks > Configurar notificações)
MERCADOPAGO_WEBHOOK_SECRET=

# Endereço público do site (sem barra no fim). Em produção, o https da Netlify:
# é pra onde o Mercado Pago devolve o cliente e manda o aviso de pagamento.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email de venda nova pro dono (lib/aviso-dono.ts). Sem estas, não manda nada.
# Hoje: Gmail com SENHA DE APP (myaccount.google.com/apppasswords, exige
# verificação em duas etapas) — não é a senha normal da conta.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=<o gmail>  SMTP_PASS=<senha de app>
# Com domínio próprio, dá pra trocar pra Resend sem mexer no código:
#   SMTP_HOST=smtp.resend.com  SMTP_USER=resend  SMTP_PASS=<api key>  EMAIL_DE=pedidos@<dominio>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente; vazio usa o SMTP_USER
EMAIL_DE=
# Pra quem vai o aviso — o email do dono. Fica aqui e não na config do painel
# porque a config é legível pela chave pública.
AVISO_EMAIL_PARA=
