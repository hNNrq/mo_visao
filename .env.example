# ==========================================================
# Mo Visão — variáveis de ambiente
# Copiar pra .env.local e preencher. O .env.local NÃO vai pro git.
# ==========================================================

# Supabase — painel do projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ Service role ignora todas as regras de segurança do banco.
# SÓ no servidor. Nunca prefixar com NEXT_PUBLIC_, nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — conta do DONO, nunca a da Norman.dgt
# Credenciais em: mercadopago.com.br/developers > Suas integrações
# Em teste, o Access Token de TESTE (ver DEPLOY.md, seção 6)
MERCADOPAGO_ACCESS_TOKEN=
# ainda não lida: o Checkout Pro não precisa dela
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Chave secreta do webhook (Webhooks > Configurar notificações)
MERCADOPAGO_WEBHOOK_SECRET=

# Melhor Envio — cota PAC e SEDEX (DEPLOY.md, seção 2.6). Conta do DONO.
MELHORENVIO_TOKEN=
# 1 = ambiente de teste (sandbox.melhorenvio.com.br)
MELHORENVIO_SANDBOX=

# Email transacional (Resend) — opcional; sem chave, o site não manda email
RESEND_API_KEY=
# "Mó Visão <pedidos@dominio>", de um domínio verificado no Resend
EMAIL_REMETENTE=
# pra onde vai o aviso de venda; vazio = o email dos Ajustes do painel
EMAIL_DONO=

# Endereço público do site (sem barra no fim). Em produção, https: é pra onde
# o Mercado Pago devolve o cliente e manda o webhook.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Não usado: a expiração de reservas roda no pg_cron do Supabase (005_checkout.sql)
CRON_SECRET=
